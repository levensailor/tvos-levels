# Copy to .env (gitignored) and adjust. Environment variables already set take precedence.

# HTTP/WebSocket listener. 0.0.0.0 lets the Apple TV on the same LAN connect.
PORT=8000
UVICORN_HOST=0.0.0.0

# Track layout (slots, names, Logic names, BlackHole channels). Falls back to the example file.
TRACKS_CONFIG_PATH=config/tracks.json
TRACKS_EXAMPLE_PATH=config/tracks.example.json

# Comma-separated adapters: json, logic, blackhole
LEVEL_SOURCES=json,logic,blackhole

# BlackHole capture (substring match on the CoreAudio device name)
BLACKHOLE_DEVICE_NAME=BlackHole 16ch
AUDIO_SAMPLE_RATE=48000
AUDIO_BLOCK_SIZE=1024
METRIC_FLOOR_DB=-96
# Sine-calibrated RMS level that reads 0 VU
VU_REFERENCE_DBFS=-18

# Measurement and update periods (milliseconds); editable at runtime from the tvOS settings screen
DBFS_PEAK_WINDOW_MS=300
VU_INTEGRATION_MS=300
LUFS_WINDOW_MS=400
LOGIC_POLL_MS=1000
PUBLISH_INTERVAL_MS=100
STALE_AFTER_MS=3000

# Logic Pro MCP (community adapter, installed separately) for per-track fader gain
LOGIC_MCP_COMMAND=LogicProMCP
LOGIC_MCP_ARGS=
LOGIC_PRO_BUNDLE_ID=com.apple.logic10
LOGIC_TRACKS_RESOURCE_URI=logic://tracks
